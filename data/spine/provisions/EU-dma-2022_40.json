   "evidence_kind": "AUTHORITY",
   "rule": "addressee-is-public-body",
   "status": "DRAFT",
   "text": "The Commission shall establish a high-level group for the Digital Markets Act (‘the high-level group’)."
  },
  {
   "obligation_id": "EU-dma-2022:40/p2/s1",
   "paragraph": "2",
   "addressee": "UNRESOLVED",
   "modality": "duty",
   "evidence_kind": "UNTRIAGED",
   "rule": "no-rule-matched",
   "status": "DRAFT",
   "text": "The high-level group shall be composed of the following European bodies and networks:"
  },
  {
   "obligation_id": "EU-dma-2022:40/p3/s1",
   "paragraph": "3",
   "addressee": "UNRESOLVED",
   "modality": "duty",
   "evidence_kind": "UNTRIAGED",
   "rule": "no-rule-matched",
   "status": "DRAFT",
   "text": "The European bodies and networks referred to in paragraph 2 shall each have an equal number of representatives in the high-level group."
  },
  {
   "obligation_id": "EU-dma-2022:40/p3/s2",
   "paragraph": "3",
   "addressee": "UNRESOLVED",
   "modality": "prohibition",
   "evidence_kind": "UNTRIAGED",
   "rule": "no-rule-matched",
   "status": "DRAFT",
   "text": "The maximum number of members of the high-level group shall not exceed 30."
  },
  {
   "obligation_id": "EU-dma-2022:40/p4/s1",
   "paragraph": "4",
   "addressee": "AUTHORITY",
   "modality": "duty",
   "evidence_kind": "AUTHORITY",
   "rule": "addressee-is-public-body",
   "status": "DRAFT",
   "text": "The Commission shall provide secretariat services to the high-level group in order to facilitate its work."
  },
  {
   "obligation_id": "EU-dma-2022:40/p4/s2",
   "paragraph": "4",
   "addressee": "UNRESOLVED",
   "modality": "duty",
   "evidence_kind": "UNTRIAGED",
   "rule": "no-rule-matched",
   "status": "DRAFT",
   "text": "The high-level group shall be chaired by the Commission, which shall participate in its meetings."
  },
  {
   "obligation_id": "EU-dma-2022:40/p4/s3",
   "paragraph": "4",
   "addressee": "UNRESOLVED",
   "modality": "duty",
   "evidence_kind": "UNTRIAGED",
   "rule": "no-rule-matched",
   "status": "DRAFT",
   "text": "The high-level group shall meet upon request of the Commission at least once per calendar year."
  },
  {
   "obligation_id": "EU-dma-2022:40/p4/s4",
   "paragraph": "4",
   "addressee": "AUTHORITY",
   "modality": "duty",
   "evidence_kind": "AUTHORITY",
   "rule": "addressee-is-public-body",
   "status": "DRAFT",
   "text": "The Commission shall also convene a meeting of the group when so requested by the majority of the members composing the group in order to address a specific issue."
  },
  {
   "obligation_id": "EU-dma-2022:40/p6/s1",
   "paragraph": "6",
   "addressee": "UNRESOLVED",
   "modality": "duty",
   "evidence_kind": "UNTRIAGED",
   "rule": "no-rule-matched",
   "status": "DRAFT",
   "text": "The report shall be communicated to the European Parliament and to the Council."
  }
