   "paragraph": null,
   "addressee": "UNRESOLVED",
   "modality": "prohibition",
   "evidence_kind": "UNTRIAGED",
   "rule": "no-rule-matched",
   "status": "DRAFT",
   "text": "（三）尊重知识产权、商业道德，保守商业秘密，不得利用算法、数据、平台等优势，实施垄断和不正当竞争行为；"
  },
  {
   "obligation_id": "CN-genai-interim-measures-2023:4/s5",
   "paragraph": null,
   "addressee": "UNRESOLVED",
   "modality": "prohibition",
   "evidence_kind": "UNTRIAGED",
   "rule": "no-rule-matched",
   "status": "DRAFT",
